    <optimization name="com.tencent.map" refs="navigation_app"/>
    <optimization name="com.baidu.BaiduMap" refs="navigation_app"/>
    <optimization name="com.google.android.apps.maps" refs="navigation_app"/>
    <optimization name="com.waze" refs="navigation_app"/>

    <optimization name="com.google.android.apps.restore" refs="non_autorr_app"/>
    <optimization name="com.android.cts.graphics.framerateoverride" refs="non_autorr_app"/>
    <optimization name="android.display.cts" refs="non_autorr_app"/>
