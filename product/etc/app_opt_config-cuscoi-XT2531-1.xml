    <optimization name="com.android.contacts" refs="non_autorr_app"/>
    <optimization name="com.tencent.mm" parent="non_autorr_app">
        <llm>true</llm>
    </optimization>

    <optimization name="com.tencent.mm-camera_mode">
        <boost rr="60"/>
        <thermal>camera</thermal>
    </optimization>

    <optimization name="com.motorola.launcher3"/>
    <optimization name="com.android.settings"/>

</app-optimization>
